# Copy to deploy/ecs.acr.env (ignored); chmod 600. Never commit populated secrets.
# Copy verified ACR references from release-manifest.json. Use @sha256, not latest.
STEMPATH_APP_IMAGE=
STEMPATH_MIGRATE_IMAGE=
STEMPATH_POSTGRES_IMAGE=
POSTGRES_PASSWORD=
DATABASE_URL=
SESSION_SECRET=
# DATABASE_URL uses host postgres; percent-encode password URL characters.
# Dedicated pilot volume: do not point this at an existing production database.
STEMPATH_DATABASE_VOLUME=stempath_acr_pilot_postgres_data
